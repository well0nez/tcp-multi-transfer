  "protocol_flow": {
    "registration": [
      "1. Client -> Server: RegisterMessage (session_id, role, local_port)",
      "2. Server -> Client: Registered (your_public_addr, needs_probing, probe_port)",
      "3. Client -> Probe Server: Multiple ProbeMessages (if needs_probing)",
      "4. Client -> Server: probes_complete",
      "5. Server: Analyzes NAT pattern",
      "6. Server -> Both Clients: peer_info (with NAT analysis)"
    ],
    "hole_punching": [
      "7. Both Clients -> Server: ready",
      "8. Sequential Mode:",
      "  a. Client -> Server: request_attempt (attempt_num, used_ports)",
      "  b. Server -> Client: go_attempt (port, start_at)",
      "  c. Both peers: Synchronized punch at start_at",
      "  d. Repeat until desired connections or timeout"
    ],
    "file_transfer": [
      "9. Direct P2P connection established",
      "10. Sender -> Receiver: HELLO, FILE_INFO",
      "11. Receiver -> Sender: ACKs",
      "12. Sender -> Receiver: Raw file data (pipelined)",
      "13. Sender -> Receiver: DONE",
      "14. Receiver: Verifies SHA256",
      "15. Receiver -> Sender: Final ACK"
    ]
  },
  "key_concepts": {
    "nat_traversal": {
      "description": "TCP hole punching through NAT firewalls",
      "techniques": [
        "Port prediction based on NAT probing",
        "Sequential synchronized connection attempts",
        "Server-coordinated timing (start_at timestamps)"
      ]
    },
    "nat_patterns": {
      "port_preserved": "NAT doesn't change port (easy)",
      "constant_delta": "NAT adds constant offset (easy)",
      "small_range": "NAT allocates within small range (medium)",
      "random_like": "NAT allocates randomly (hard)"
    },
    "multi_tcp": {
      "description": "Multiple parallel TCP connections for higher throughput",
      "worker_pattern": "Chunk-based work distribution across streams"
    }
  },
